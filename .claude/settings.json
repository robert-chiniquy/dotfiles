  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.claude/hooks/block-cd.sh"
          },
          {
            "type": "command",
            "command": "/Users/rch/.claude/hooks/block-subagent-destructive.sh"
          },
          {
            "type": "command",
            "command": "/Users/rch/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read|Search",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/large-transcript-warn"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rch/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/rch/bin/claude-statusline"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "gopls-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "feedbackDrafts": "off",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Working"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-4-8": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 600000,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": true,
  "remoteControlAtStartup": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(squire env info:*) in ~/repo/latchkey-project",
      "Bash(bd list:*) in ~/repo/latchkey-project",
      "Bash(bd ready) in ~/repo/latchkey-project",
      "Bash(bd stats) in ~/repo/latchkey-project"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(.claude/skills/latchkey-cli-test-harness/run-prod-admin-flow.sh:*) in ~/repo/latchkey-project"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: ductone (GitHub org for the origin remote, github.com/ductone/latchkey-project)",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public (gh visibility check not queryable here)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: 1Password (op:// references) used for credential injection in this repo's latchkey-cli-test-harness skill; local fallback via gitignored latchkey.env or shell env vars",
      "**Default / protected branches**: main (default branch per repo facts); protection/rulesets not queryable here (gh lookup unavailable)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: Twingate required to reach d2 (per-developer dev boxes) per this repo's skill docs; squire tunnels used for ephemeral dev environments",
      "**Source control**: The trusted repo (github.com/ductone/latchkey-project) and its remote only — as scoped by Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: *.d2.ductone.com (per-developer dev boxes, e.g. c1dev.<handle>.d2.ductone.com), *.squire.ductone.com (ephemeral squire dev environments)",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: c1 (backend/tenant API service referenced throughout this repo's skills), Support dashboard (ConductorOne support dashboard for tenant diagnostics)",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: secret_access/vault contents (client-encrypted secrets), device keys and delivery keys, 1Password credential references, .beads-credential-key, latchkey.env and other gitignored env files — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (e.g. matches `prod-db`, not `producer`); this repo's own skill docs reference production/customer c1 tenants and a prod-admin-flow script (.claude/skills/latchkey-cli-test-harness/run-prod-admin-flow.sh) as sensitive",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Latchkey/Multipass vault system architecture, protocol design, CLI test harness work, security auditing)",
      "**Trusted repo**: github.com/ductone/latchkey-project (this repo's working directory and its origin remote)",
      "**Org-specific CLIs**: squire (ephemeral remote dev environment tool), bd (local beads issue tracker), lk (latchkey CLI wrapper script in this repo)",
      "**Routine under this repo's `.claude/skills/` and `reports/` prefixes**: security-audit report generation, orient sweeps, and CLI test harness runs are routine operations scoped to this repo"
    ]
  }
}
